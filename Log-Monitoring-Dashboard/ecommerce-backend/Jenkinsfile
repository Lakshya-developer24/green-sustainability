pipeline {
    agent any

    environment {
        // ----------------------------------------------------
        // REPLACE THESE WITH YOUR JENKINS TARGET DETAILS
        // ----------------------------------------------------
        DOCKER_HUB_CREDENTIALS_ID = 'docker-hub-credentials'
        DOCKER_IMAGE = 'lakshyaarya/ecommerce-backend' 
        EC2_SSH_CREDENTIALS_ID = 'ec2-ssh-key' 
        EC2_IP_ADDRESS = 'your.ec2.ip.address' 
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir('ecommerce-backend') {
                    script {
                        dockerImage = docker.build("${DOCKER_IMAGE}:${env.BUILD_ID}")
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', DOCKER_HUB_CREDENTIALS_ID) {
                        dockerImage.push()
                        dockerImage.push('latest')
                    }
                }
            }
        }
        
        stage('Deploy to EC2') {
            steps {
                sshagent([EC2_SSH_CREDENTIALS_ID]) {
                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@${EC2_IP_ADDRESS} '
                            cd /home/ubuntu/Log-Monitoring-Dashboard/ecommerce-backend &&
                            docker-compose pull backend &&
                            docker-compose up -d --no-deps backend
                        '
                    """
                }
            }
        }
    }
}
